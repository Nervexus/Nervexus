// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A folder notes live in. There's always at least the "default" one
// (seeded by the migration that added this table); the user can add more
// from the Notes page. Locking stores a salted hash of a PIN, never the
// PIN itself -- see lib/pin.ts.
model NoteFolder {
  id        String   @id @default(cuid())
  name      String
  locked    Boolean  @default(false)
  pinHash   String?
  pinSalt   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
}

model Note {
  id        String     @id @default(cuid())
  title     String
  body      String
  pinned    Boolean    @default(false)
  folderId  String     @default("default")
  folder    NoteFolder @relation(fields: [folderId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Secret values are encrypted (AES-256-GCM, see lib/crypto.ts) before they
// ever reach the database -- cipherText/iv/authTag are the only things
// stored, never the plaintext secret.
model VaultItem {
  id         String   @id @default(cuid())
  title      String
  cipherText String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String    @id @default(cuid())
  title     String
  note      String?
  dueAt     DateTime
  done      Boolean   @default(false)
  priority  String    @default("normal") // "low" | "normal" | "high"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A record of what Laura actually did, for the home page's Activity feed --
// not every tool call (get_current_time/list_reminders are read-only noise),
// just the ones with a real-world effect or worth showing you happened.
model ActivityLog {
  id        String   @id @default(cuid())
  tool      String
  summary   String
  createdAt DateTime @default(now())
}

// A record of every real notification Laura has sent via Telegram -- the
// Calls page's history, and a paper trail if one fails.
model CallLog {
  id         String   @id @default(cuid())
  kind       String // "call" (urgent-styled) | "sms" (plain message)
  target     String // the Telegram chat id this went to
  message    String
  status     String // "sent" | "failed"
  error      String?
  providerId String? // Telegram's own message_id, if sent
  createdAt  DateTime @default(now())
}

// One work shift, entered by hand or extracted from a photographed rota
// (see lib/rota.ts) -- confidence/source let the Rota page flag
// AI-extracted shifts for review before they're trusted the same as a
// hand-entered one.
model Shift {
  id          String   @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  location    String?
  colleagues  String? // comma-separated names, as given
  note        String?
  source      String   @default("manual") // "manual" | "photo"
  commutePlan String? // Laura's generated "when to leave" text, if asked for
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton (id is always "me") -- the home/work addresses and arrival
// buffer that commute planning needs. Deliberately not per-user since
// this whole app is single-user.
model Profile {
  id                   String   @id @default("me")
  homeAddress          String?
  workAddress          String?
  arrivalBufferMinutes Int      @default(15)
  updatedAt            DateTime @updatedAt
}

// A restaurant/activity booking Laura is tracking -- never one she's paid
// for or finalized herself (see lib/booking.ts): status moves from "idea"
// (just researched) to "pending" (the user said they'd book it) to
// "confirmed" (the user did, usually with a confirmation number in note)
// or "cancelled". link points at wherever the user actually completes it.
model Booking {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("other") // "restaurant" | "activity" | "travel" | "other"
  dateTime  DateTime?
  partySize Int?
  location  String?
  link      String?
  status    String   @default("idea") // "idea" | "pending" | "confirmed" | "cancelled"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A content idea Laura's helped brainstorm (caption, hashtags, location,
// outfit) or the user's noted themselves -- no real Instagram account is
// connected yet (see lib/instagram.ts), so this is planning/tracking only.
// status moves "idea" -> "scheduled" (user picked a date) -> "posted"
// (user tells Laura they posted it) or "discarded".
model ContentIdea {
  id          String    @id @default(cuid())
  type        String    @default("post") // "post" | "reel" | "story" | "other"
  title       String
  caption     String?
  hashtags    String? // comma-separated, no '#'
  location    String?
  outfit      String?
  scheduledAt DateTime?
  status      String    @default("idea") // "idea" | "scheduled" | "posted" | "discarded"
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
