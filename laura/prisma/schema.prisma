// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Secret values are encrypted (AES-256-GCM, see lib/crypto.ts) before they
// ever reach the database -- cipherText/iv/authTag are the only things
// stored, never the plaintext secret.
model VaultItem {
  id         String   @id @default(cuid())
  title      String
  cipherText String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Reminder {
  id        String    @id @default(cuid())
  title     String
  note      String?
  dueAt     DateTime
  done      Boolean   @default(false)
  priority  String    @default("normal") // "low" | "normal" | "high"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A record of what Laura actually did, for the home page's Activity feed --
// not every tool call (get_current_time/list_reminders are read-only noise),
// just the ones with a real-world effect or worth showing you happened.
model ActivityLog {
  id        String   @id @default(cuid())
  tool      String
  summary   String
  createdAt DateTime @default(now())
}

// A record of every real-world call/text Laura has placed via Twilio --
// the Calls page's history, and a paper trail if a call fails or a trial
// account's number restrictions block one.
model CallLog {
  id         String   @id @default(cuid())
  kind       String // "call" | "sms"
  toNumber   String
  message    String
  status     String // "sent" | "failed"
  error      String?
  twilioSid  String?
  createdAt  DateTime @default(now())
}
