# Core brain (Gemini free tier -- get a key at aistudio.google.com/apikey)
GEMINI_API_KEY=

# Storage (Notes, Vault, chat history) -- hosted libSQL (Turso), used for
# both local dev and production. Create a database at turso.tech, then
# grab these from its dashboard (Connect tab + "Create Token").
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=

# Encrypts Vault entries at rest (AES-256-GCM). Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Calls & texts (Twilio) -- sign up at twilio.com, verify your own number
# (required on a free trial), then grab these from the console home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number you were given/bought.
TWILIO_PHONE_NUMBER=
# Your own (verified, on a trial account) phone number -- the only number
# Laura ever calls/texts.
OWNER_PHONE_NUMBER=
# Only needed for local dev, so Twilio's webhook can reach a public URL
# (e.g. an ngrok tunnel) instead of localhost. Not needed on Vercel, which
# sets VERCEL_URL automatically.
# PUBLIC_BASE_URL=

# Added in later phases — not used yet:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
