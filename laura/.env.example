# Core brain (Gemini free tier -- get a key at aistudio.google.com/apikey)
GEMINI_API_KEY=

# Storage (Notes, Vault, chat history) -- hosted libSQL (Turso), used for
# both local dev and production. Create a database at turso.tech, then
# grab these from its dashboard (Connect tab + "Create Token").
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN=

# Encrypts Vault entries at rest (AES-256-GCM). Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Calls & texts (Telegram Bot API -- free, no trial limits, no card).
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#    It gives you a token -- that's TELEGRAM_BOT_TOKEN.
# 2. Send your new bot any message (so it has a chat to reply into).
# 3. Visit https://api.telegram.org/bot<token>/getUpdates in a browser and
#    copy the "chat":{"id": ...} number -- that's TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random string Telegram echoes back on every webhook call, so only
# Telegram can reach /api/telegram/webhook. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Secures /api/briefing/send, the endpoint Vercel Cron hits daily to text
# tomorrow's briefing unprompted (see vercel.json for the schedule --
# defaults to 19:00 UTC, edit the cron expression there for your own
# timezone/evening). Vercel sends this as a Bearer token automatically once
# the env var is set on the project -- nothing else to configure. Generate
# with:
#   openssl rand -hex 32
CRON_SECRET=

# Added in later phases — not used yet:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# The one password that signs you in to the app (any length; longer is better).
APP_PASSWORD=
